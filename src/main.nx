// nyx-shell — Interactive POSIX shell written in Nyx
// Spawns children with std/process (try_spawn, try_spawn_pipeline); no fork.
// Uses builtins: getcwd, chdir, getpid, getenv, setenv, isatty, stat
// Uses terminal builtins: raw_mode_enter/exit, read_byte, term_cols, chr
//
// Features:
//   - Interactive prompt (user@host:cwd$)
//   - Built-in commands: cd, pwd, exit, export, echo, history, type, unset
//   - External command execution via std/process (try_spawn)
//   - PATH lookup for commands
//   - Pipes (cmd1 | cmd2 | cmd3)
//   - Output redirect (cmd > file, cmd >> file)
//   - Input redirect (cmd < file)
//   - Command sequences (cmd1 ; cmd2)  [via tokenizer]
//   - Conditional execution (cmd1 && cmd2, cmd1 || cmd2)
//   - Quoting (single and double quotes)
//   - Environment variable expansion ($VAR, ${VAR})
//   - Command history with arrow keys (persistent ~/.nyx_history)
//   - Line editing (arrows, home/end, backspace, delete, Ctrl+A/E/K/U/W/L)

import "std/error"
import "std/process"

// ===== CONSTANTS =====

const MAX_HISTORY = 500
let HISTORY_FILE: String = ".nyx_history"

// ===== GLOBAL STATE =====

var g_history: Array = []
var g_running: bool = true
var g_last_exit: int = 0

// ===== STRING UTILITIES =====

fn starts_with(s: String, prefix: String) -> bool {
    if prefix.length() > s.length() {
        return false
    }
    return s.substring(0, prefix.length()) == prefix
}

fn char_at(s: String, i: int) -> int {
    return s.charAt(i)
}

fn is_whitespace(c: int) -> bool {
    return c == 32 or c == 9
}

fn string_repeat(s: String, n: int) -> String {
    var result: String = ""
    var i = 0
    while i < n {
        result = result + s
        i = i + 1
    }
    return result
}

// ===== ENVIRONMENT VARIABLE EXPANSION =====

fn expand_vars(input: String) -> String {
    var result: String = ""
    var i = 0
    let len: int = input.length()

    while i < len {
        let c: int = char_at(input, i)

        if c == 39 {
            // single quote — no expansion, pass through until closing '
            i = i + 1
            while i < len {
                let cc: int = char_at(input, i)
                if cc == 39 {
                    i = i + 1
                    break
                }
                result = result + chr(cc)
                i = i + 1
            }
        } else if c == 36 {
            // $ — variable expansion
            i = i + 1
            if i >= len {
                result = result + "$"
            } else {
                let next: int = char_at(input, i)
                if next == 123 {
                    // ${VAR}
                    i = i + 1
                    var var_name: String = ""
                    while i < len {
                        let vc: int = char_at(input, i)
                        if vc == 125 {
                            i = i + 1
                            break
                        }
                        var_name = var_name + chr(vc)
                        i = i + 1
                    }
                    result = result + getenv(var_name)
                } else if next == 63 {
                    // $?
                    result = result + int_to_string(g_last_exit)
                    i = i + 1
                } else if next == 36 {
                    // $$
                    result = result + int_to_string(getpid())
                    i = i + 1
                } else {
                    // $VAR_NAME
                    var var_name: String = ""
                    while i < len {
                        let vc: int = char_at(input, i)
                        let is_alpha: bool = (vc >= 65 and vc <= 90) or (vc >= 97 and vc <= 122)
                        let is_digit: bool = vc >= 48 and vc <= 57
                        let is_under: bool = vc == 95
                        if is_alpha or is_digit or is_under {
                            var_name = var_name + chr(vc)
                            i = i + 1
                        } else {
                            break
                        }
                    }
                    if var_name.length() > 0 {
                        result = result + getenv(var_name)
                    } else {
                        result = result + "$"
                    }
                }
            }
        } else if c == 126 {
            // ~ expansion at start or after whitespace
            var at_word_start: bool = i == 0
            if i > 0 {
                at_word_start = is_whitespace(char_at(input, i - 1))
            }
            if at_word_start {
                let home: String = getenv("HOME")
                if home != "" {
                    result = result + home
                } else {
                    result = result + "~"
                }
            } else {
                result = result + "~"
            }
            i = i + 1
        } else {
            result = result + chr(c)
            i = i + 1
        }
    }
    return result
}

// ===== TOKENIZER =====

fn tokenize(input: String) -> Array {
    var tokens: Array = []
    var current: String = ""
    var i = 0
    let len: int = input.length()
    var in_single_quote = false
    var in_double_quote = false

    while i < len {
        let c: int = char_at(input, i)

        if in_single_quote {
            if c == 39 {
                in_single_quote = false
            } else {
                current = current + chr(c)
            }
            i = i + 1
        } else if in_double_quote {
            if c == 34 {
                in_double_quote = false
                i = i + 1
            } else if c == 92 and i + 1 < len {
                // backslash in double quotes
                i = i + 1
                let nc: int = char_at(input, i)
                if nc == 34 or nc == 92 or nc == 36 {
                    current = current + chr(nc)
                } else {
                    current = current + "\\" + chr(nc)
                }
                i = i + 1
            } else {
                current = current + chr(c)
                i = i + 1
            }
        } else if c == 39 {
            in_single_quote = true
            i = i + 1
        } else if c == 34 {
            in_double_quote = true
            i = i + 1
        } else if c == 92 and i + 1 < len {
            // backslash escape
            i = i + 1
            let nc: int = char_at(input, i)
            current = current + chr(nc)
            i = i + 1
        } else if c == 124 {
            // pipe |
            if current.length() > 0 {
                tokens.push(current)
                current = ""
            }
            tokens.push("|")
            i = i + 1
        } else if c == 62 {
            // > or >>
            if current.length() > 0 {
                tokens.push(current)
                current = ""
            }
            if i + 1 < len and char_at(input, i + 1) == 62 {
                tokens.push(">>")
                i = i + 2
            } else {
                tokens.push(">")
                i = i + 1
            }
        } else if c == 60 {
            // <
            if current.length() > 0 {
                tokens.push(current)
                current = ""
            }
            tokens.push("<")
            i = i + 1
        } else if c == 59 {
            // semicolon
            if current.length() > 0 {
                tokens.push(current)
                current = ""
            }
            tokens.push("SEQ")
            i = i + 1
        } else if c == 38 {
            // & or &&
            if current.length() > 0 {
                tokens.push(current)
                current = ""
            }
            if i + 1 < len and char_at(input, i + 1) == 38 {
                tokens.push("&&")
                i = i + 2
            } else {
                tokens.push("&")
                i = i + 1
            }
        } else if c == 124 and i + 1 < len and char_at(input, i + 1) == 124 {
            // ||
            if current.length() > 0 {
                tokens.push(current)
                current = ""
            }
            tokens.push("||")
            i = i + 2
        } else if is_whitespace(c) {
            if current.length() > 0 {
                tokens.push(current)
                current = ""
            }
            i = i + 1
        } else {
            current = current + chr(c)
            i = i + 1
        }
    }
    if current.length() > 0 {
        tokens.push(current)
    }
    return tokens
}

// ===== COMMAND PARSING =====

struct SimpleCommand {
    args: Array,
    stdout_file: String,
    stdout_append: bool,
    stdin_file: String
}

fn parse_simple_command(tokens: Array, start: int, end_idx: int) -> SimpleCommand {
    var cmd = SimpleCommand {
        args: [],
        stdout_file: "",
        stdout_append: false,
        stdin_file: ""
    }

    var i: int = start
    while i < end_idx {
        let tok: String = tokens[i]
        if tok == ">" and i + 1 < end_idx {
            let target: String = tokens[i + 1]
            cmd.stdout_file = target
            cmd.stdout_append = false
            i = i + 2
        } else if tok == ">>" and i + 1 < end_idx {
            let target: String = tokens[i + 1]
            cmd.stdout_file = target
            cmd.stdout_append = true
            i = i + 2
        } else if tok == "<" and i + 1 < end_idx {
            let target: String = tokens[i + 1]
            cmd.stdin_file = target
            i = i + 2
        } else {
            cmd.args.push(tok)
            i = i + 1
        }
    }
    return cmd
}

fn split_by_pipe(tokens: Array) -> Array {
    var segments: Array = []
    var start = 0
    var i = 0
    while i < tokens.length() {
        let tok: String = tokens[i]
        if tok == "|" {
            segments.push(parse_simple_command(tokens, start, i))
            start = i + 1
        }
        i = i + 1
    }
    segments.push(parse_simple_command(tokens, start, tokens.length()))
    return segments
}

// ===== PATH LOOKUP =====

fn find_in_path(cmd: String) -> String {
    if cmd.contains("/") {
        let st: Array = stat(cmd)
        if st.length() > 0 {
            let size: int = st[0]
            if size >= 0 {
                return cmd
            }
        }
        return ""
    }

    let path_str: String = getenv("PATH")
    if path_str == "" {
        return ""
    }

    let dirs: Array = path_str.split(":")
    var i = 0
    while i < dirs.length() {
        let dir: String = dirs[i]
        let full: String = dir + "/" + cmd
        let st: Array = stat(full)
        if st.length() > 0 {
            let size: int = st[0]
            if size >= 0 {
                return full
            }
        }
        i = i + 1
    }
    return ""
}

// ===== BUILT-IN COMMANDS =====

fn builtin_cd(args: Array) -> int {
    var target: String = ""
    if args.length() < 2 {
        target = getenv("HOME")
        if target == "" {
            print("cd: HOME not set")
            return 1
        }
    } else {
        let arg: String = args[1]
        if arg == "-" {
            target = getenv("OLDPWD")
            if target == "" {
                print("cd: OLDPWD not set")
                return 1
            }
            print(target)
        } else {
            target = arg
        }
    }

    let old: String = getcwd()
    let rc: int = chdir(target)
    if rc != 0 {
        print("cd: " + target + ": No such file or directory")
        return 1
    }
    setenv("OLDPWD", old)
    setenv("PWD", getcwd())
    return 0
}

fn builtin_pwd(args: Array) -> int {
    out_line(getcwd())
    return 0
}

fn builtin_echo(args: Array) -> int {
    var output: String = ""
    var i = 1
    var no_newline = false
    var first_arg = true

    if i < args.length() {
        let first: String = args[i]
        if first == "-n" {
            no_newline = true
            i = i + 1
        }
    }

    while i < args.length() {
        if not first_arg {
            output = output + " "
        }
        first_arg = false
        let part: String = args[i]
        output = output + part
        i = i + 1
    }

    if no_newline {
        out_raw(output)
    } else {
        out_line(output)
    }
    return 0
}

fn builtin_export(args: Array) -> int {
    if args.length() < 2 {
        print("export: usage: export NAME=value")
        return 1
    }
    var i = 1
    while i < args.length() {
        let arg: String = args[i]
        var eq_pos = -1
        var j = 0
        while j < arg.length() {
            if char_at(arg, j) == 61 {
                eq_pos = j
                j = arg.length()
            } else {
                j = j + 1
            }
        }
        if eq_pos > 0 {
            let name: String = arg.substring(0, eq_pos)
            let value: String = arg.substring(eq_pos + 1, arg.length())
            setenv(name, value)
        }
        i = i + 1
    }
    return 0
}

fn builtin_unset(args: Array) -> int {
    if args.length() < 2 {
        print("unset: usage: unset NAME")
        return 1
    }
    var i = 1
    while i < args.length() {
        let name: String = args[i]
        setenv(name, "")
        i = i + 1
    }
    return 0
}

fn builtin_type(args: Array) -> int {
    if args.length() < 2 {
        out_line("type: usage: type command")
        return 1
    }
    let cmd: String = args[1]
    if is_builtin(cmd) {
        out_line(cmd + " is a shell builtin")
        return 0
    }
    let found: String = find_in_path(cmd)
    if found != "" {
        out_line(cmd + " is " + found)
        return 0
    }
    out_line("type: " + cmd + ": not found")
    return 1
}

fn builtin_history(args: Array) -> int {
    var i = 0
    while i < g_history.length() {
        let entry: String = g_history[i]
        let num: String = int_to_string(i + 1)
        out_line("  " + num + "  " + entry)
        i = i + 1
    }
    return 0
}

fn is_builtin(cmd: String) -> bool {
    if cmd == "cd" { return true }
    if cmd == "pwd" { return true }
    if cmd == "echo" { return true }
    if cmd == "exit" { return true }
    if cmd == "export" { return true }
    if cmd == "unset" { return true }
    if cmd == "type" { return true }
    if cmd == "history" { return true }
    return false
}

fn run_builtin(args: Array) -> int {
    let cmd: String = args[0]
    if cmd == "cd" {
        return builtin_cd(args)
    }
    if cmd == "pwd" {
        return builtin_pwd(args)
    }
    if cmd == "echo" {
        return builtin_echo(args)
    }
    if cmd == "export" {
        return builtin_export(args)
    }
    if cmd == "unset" {
        return builtin_unset(args)
    }
    if cmd == "type" {
        return builtin_type(args)
    }
    if cmd == "history" {
        return builtin_history(args)
    }
    if cmd == "exit" {
        var code = 0
        if args.length() > 1 {
            let c: String = args[1]
            code = string_to_int(c)
        }
        g_running = false
        return code
    }
    return 127
}

// ===== EXTERNAL COMMAND EXECUTION =====
//
// Los procesos hijos se lanzan con std/process (try_spawn / try_spawn_pipeline),
// no con fork+execvp: las redirecciones `<`, `>` y `>>` son Stdio.File y los
// pipes los arma try_spawn_pipeline.

// Stdio de las redirecciones de un comando simple.
fn stdin_of(cmd: SimpleCommand) -> Stdio {
    if cmd.stdin_file != "" {
        return Stdio.File(cmd.stdin_file, "r")
    }
    return Stdio.Inherit
}

fn stdout_of(cmd: SimpleCommand) -> Stdio {
    if cmd.stdout_file != "" {
        if cmd.stdout_append {
            return Stdio.File(cmd.stdout_file, "a")
        }
        return Stdio.File(cmd.stdout_file, "w")
    }
    return Stdio.Inherit
}

// Traduce un Err de try_spawn al mensaje y al código de salida del shell.
// std/process no distingue por kind un archivo de redirección que no abre de
// un programa inexistente (los dos son not_found), así que se mira el msg.
fn report_spawn_error(e: Error, program: String, stdin_file: String, stdout_file: String) -> int {
    if e.msg.contains(": no se pudo preparar stdin") {
        print("nyx-shell: " + stdin_file + ": No such file or directory")
        return 1
    }
    if e.msg.contains(": no se pudo preparar stdout") {
        print("nyx-shell: " + stdout_file + ": Cannot open")
        return 1
    }
    if e.kind == "not_found" {
        print("nyx-shell: " + program + ": command not found")
        return 127
    }
    print("nyx-shell: " + program + ": exec failed")
    return 126
}

fn wait_code(c: Child) -> int {
    match try_child_wait(c) {
        Result.Ok(code) => { return code }
        Result.Err(e) => {
            print("nyx-shell: wait failed: " + e.msg)
            return 1
        }
    }
    return 1
}

fn exec_external(cmd: SimpleCommand) -> int {
    let program: String = cmd.args[0]
    let resolved: String = find_in_path(program)
    if resolved == "" {
        print("nyx-shell: " + program + ": command not found")
        return 127
    }

    var opts = spawn_opts()
    opts.stdin = stdin_of(cmd)
    opts.stdout = stdout_of(cmd)
    match try_spawn(cmd.args, opts) {
        Result.Ok(child) => { return wait_code(child) }
        Result.Err(e) => { return report_spawn_error(e, resolved, cmd.stdin_file, cmd.stdout_file) }
    }
    return 1
}

fn builtin_needs_parent(cmd: String) -> bool {
    // These builtins must run in parent (they modify shell state)
    if cmd == "cd" { return true }
    if cmd == "export" { return true }
    if cmd == "unset" { return true }
    if cmd == "exit" { return true }
    return false
}

// Salida de los builtins: con g_capture activo va a g_capbuf en vez de a la
// terminal, para poder redirigirla a un archivo sin hacer fork.
var g_capture: bool = false
var g_capbuf: String = ""

fn out_line(s: String) {
    if g_capture {
        g_capbuf = g_capbuf + s + "\n"
    } else {
        print(s)
    }
}

fn out_raw(s: String) {
    if g_capture {
        g_capbuf = g_capbuf + s
    } else {
        print_no_newline(s)
    }
}

// Corre un builtin cuya salida va a un archivo (`echo hi > f`, `pwd >> f`).
// Sin fork: se captura el texto y se lo entrega a un `cat` con el archivo como
// stdout (modo "w" o "a"), que es lo que hacía el hijo con dup2.
fn run_builtin_redirected(cmd: SimpleCommand) -> int {
    g_capture = true
    g_capbuf = ""
    let rc: int = run_builtin(cmd.args)
    g_capture = false
    let text: String = g_capbuf
    g_capbuf = ""

    var opts = spawn_opts()
    opts.stdin = Stdio.Pipe
    opts.stdout = stdout_of(cmd)
    match try_spawn(["cat"], opts) {
        Result.Ok(c) => {
            let _w = try_child_write(c, text)
            let _x = try_child_close_stdin(c)
            let _y = try_child_wait(c)
            return rc
        }
        Result.Err(e) => {
            print("nyx-shell: " + cmd.stdout_file + ": Cannot open")
            return 1
        }
    }
    return rc
}

fn exec_command(cmd: SimpleCommand) -> int {
    if cmd.args.length() == 0 {
        return 0
    }

    let program: String = cmd.args[0]

    if is_builtin(program) {
        if cmd.stdout_file != "" and not builtin_needs_parent(program) {
            return run_builtin_redirected(cmd)
        }
        return run_builtin(cmd.args)
    }
    return exec_external(cmd)
}

// ===== PIPELINE EXECUTION =====

fn exec_pipeline(commands: Array) -> int {
    let n: int = commands.length()

    if n == 1 {
        let cmd: SimpleCommand = commands[0]
        return exec_command(cmd)
    }

    // Todos los programas tienen que existir antes de lanzar el primero.
    var argvs: Array = []
    var ci = 0
    while ci < n {
        let cmd: SimpleCommand = commands[ci]
        if cmd.args.length() > 0 {
            let program: String = cmd.args[0]
            if find_in_path(program) == "" {
                print("nyx-shell: " + program + ": command not found")
                return 127
            }
            argvs.push(cmd.args)
        }
        ci = ci + 1
    }
    if argvs.length() == 0 {
        return 0
    }

    // `<` solo vale en el primero y `>`/`>>` en el último.
    var opts = spawn_opts()
    var in_file = ""
    var out_file = ""
    let first: SimpleCommand = commands[0]
    if first.args.length() > 0 {
        opts.stdin = stdin_of(first)
        in_file = first.stdin_file
    }
    let last: SimpleCommand = commands[n - 1]
    if last.args.length() > 0 {
        opts.stdout = stdout_of(last)
        out_file = last.stdout_file
    }

    match try_spawn_pipeline(argvs, opts) {
        Result.Ok(children) => {
            // Esperar a todos; el código es el del último.
            var last_status = 0
            var wi = 0
            while wi < children.length() {
                let c: Child = children[wi]
                let status: int = wait_code(c)
                if wi == children.length() - 1 {
                    last_status = status
                }
                wi = wi + 1
            }
            return last_status
        }
        Result.Err(e) => {
            return report_spawn_error(e, "pipeline", in_file, out_file)
        }
    }
    return 1
}

// ===== COMMAND LINE EXECUTION =====

fn execute_line(line: String) {
    let expanded: String = expand_vars(line)
    let tokens: Array = tokenize(expanded)
    if tokens.length() == 0 {
        return
    }

    // Split by SEQ (;), && and ||
    var segments: Array = []
    var operators: Array = []
    var seg_start = 0
    var i = 0

    while i < tokens.length() {
        let tok: String = tokens[i]
        if tok == "SEQ" or tok == "&&" or tok == "||" {
            var seg: Array = []
            var j: int = seg_start
            while j < i {
                let t: String = tokens[j]
                seg.push(t)
                j = j + 1
            }
            if seg.length() > 0 {
                segments.push(seg)
                operators.push(tok)
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    // Last segment
    var last_seg: Array = []
    var j: int = seg_start
    while j < tokens.length() {
        let t: String = tokens[j]
        last_seg.push(t)
        j = j + 1
    }
    if last_seg.length() > 0 {
        segments.push(last_seg)
    }

    // Execute segments with operator logic
    var si = 0
    while si < segments.length() {
        if not g_running {
            return
        }

        let seg: Array = segments[si]
        let pipeline: Array = split_by_pipe(seg)
        g_last_exit = exec_pipeline(pipeline)

        // Check operators for next segment
        if si < operators.length() {
            let op: String = operators[si]
            if op == "&&" and g_last_exit != 0 {
                return
            }
            if op == "||" and g_last_exit == 0 {
                si = si + 1
                if si >= segments.length() {
                    return
                }
            }
        }

        si = si + 1
    }
}

// ===== HISTORY =====

fn load_history() {
    let home: String = getenv("HOME")
    if home == "" {
        return
    }
    let path: String = home + "/" + HISTORY_FILE
    if not file_exists(path) {
        return
    }
    let content: String = read_file(path)
    let lines: Array = content.split("\n")
    var i = 0
    while i < lines.length() {
        let line: String = lines[i]
        if line.length() > 0 {
            g_history.push(line)
        }
        i = i + 1
    }
    while g_history.length() > MAX_HISTORY {
        g_history.remove(0)
    }
}

fn save_history() {
    let home: String = getenv("HOME")
    if home == "" {
        return
    }
    let path: String = home + "/" + HISTORY_FILE
    var content: String = ""
    var i = 0
    while i < g_history.length() {
        let entry: String = g_history[i]
        content = content + entry + "\n"
        i = i + 1
    }
    write_file(path, content)
}

fn add_history(line: String) {
    if line.length() == 0 {
        return
    }
    if g_history.length() > 0 {
        let last: String = g_history[g_history.length() - 1]
        if last == line {
            return
        }
    }
    g_history.push(line)
    while g_history.length() > MAX_HISTORY {
        g_history.remove(0)
    }
}

// ===== PROMPT =====

fn render_prompt() -> String {
    let user: String = getenv("USER")
    let host: String = getenv("HOSTNAME")
    let cwd: String = getcwd()
    let home: String = getenv("HOME")

    var display_cwd: String = cwd
    if home.length() > 0 and starts_with(cwd, home) {
        display_cwd = "~" + cwd.substring(home.length(), cwd.length())
    }

    var prompt: String = ""
    if user != "" {
        prompt = user
        if host != "" {
            prompt = prompt + "@" + host
        }
        prompt = prompt + ":" + display_cwd
    } else {
        prompt = display_cwd
    }

    if getenv("USER") == "root" {
        prompt = prompt + "# "
    } else {
        prompt = prompt + "$ "
    }
    return prompt
}

// ===== LINE EDITOR (raw mode) =====

fn redraw_line(prompt: String, buf: String, cursor: int) {
    let clear_str: String = string_repeat(" ", buf.length() + 5)
    print_no_newline("\r" + prompt + clear_str)
    print_no_newline("\r" + prompt + buf)
    // Move cursor to position
    if cursor < buf.length() {
        let move_back: int = buf.length() - cursor
        var mi = 0
        while mi < move_back {
            print_no_newline(chr(8))
            mi = mi + 1
        }
    }
}

fn read_line_interactive() -> String {
    let prompt: String = render_prompt()
    print_no_newline(prompt)

    var buf: String = ""
    var cursor = 0
    var hist_pos: int = g_history.length()
    var saved_line: String = ""

    raw_mode_enter()

    var editing = true
    while editing {
        let b: int = read_byte()

        if b == 10 or b == 13 {
            // Enter
            raw_mode_exit()
            print("")
            return buf
        } else if b == 4 {
            // Ctrl+D
            if buf.length() == 0 {
                raw_mode_exit()
                print("")
                g_running = false
                return ""
            }
        } else if b == 3 {
            // Ctrl+C
            raw_mode_exit()
            print("^C")
            return ""
        } else if b == 1 {
            // Ctrl+A — home
            cursor = 0
            print_no_newline("\r" + prompt)
        } else if b == 5 {
            // Ctrl+E — end
            cursor = buf.length()
            print_no_newline("\r" + prompt + buf)
        } else if b == 11 {
            // Ctrl+K — kill to end
            buf = buf.substring(0, cursor)
            redraw_line(prompt, buf, cursor)
        } else if b == 21 {
            // Ctrl+U — kill to start
            buf = buf.substring(cursor, buf.length())
            cursor = 0
            redraw_line(prompt, buf, cursor)
        } else if b == 23 {
            // Ctrl+W — delete word back
            var pos: int = cursor
            while pos > 0 and char_at(buf, pos - 1) == 32 {
                pos = pos - 1
            }
            while pos > 0 and char_at(buf, pos - 1) != 32 {
                pos = pos - 1
            }
            buf = buf.substring(0, pos) + buf.substring(cursor, buf.length())
            cursor = pos
            redraw_line(prompt, buf, cursor)
        } else if b == 12 {
            // Ctrl+L — clear screen
            print_no_newline(chr(27) + "[2J" + chr(27) + "[H")
            print_no_newline(prompt + buf)
        } else if b == 127 or b == 8 {
            // Backspace
            if cursor > 0 {
                buf = buf.substring(0, cursor - 1) + buf.substring(cursor, buf.length())
                cursor = cursor - 1
                redraw_line(prompt, buf, cursor)
            }
        } else if b == 27 {
            // ESC sequence
            let b2: int = read_byte()
            if b2 == 91 {
                let b3: int = read_byte()
                if b3 == 65 {
                    // Up arrow — history previous
                    if hist_pos > 0 {
                        if hist_pos == g_history.length() {
                            saved_line = buf
                        }
                        hist_pos = hist_pos - 1
                        let entry: String = g_history[hist_pos]
                        buf = entry
                        cursor = buf.length()
                        redraw_line(prompt, buf, cursor)
                    }
                } else if b3 == 66 {
                    // Down arrow — history next
                    if hist_pos < g_history.length() {
                        hist_pos = hist_pos + 1
                        if hist_pos == g_history.length() {
                            buf = saved_line
                        } else {
                            let entry: String = g_history[hist_pos]
                            buf = entry
                        }
                        cursor = buf.length()
                        redraw_line(prompt, buf, cursor)
                    }
                } else if b3 == 67 {
                    // Right arrow
                    if cursor < buf.length() {
                        cursor = cursor + 1
                        print_no_newline(chr(27) + "[C")
                    }
                } else if b3 == 68 {
                    // Left arrow
                    if cursor > 0 {
                        cursor = cursor - 1
                        print_no_newline(chr(27) + "[D")
                    }
                } else if b3 == 72 {
                    // Home
                    cursor = 0
                    print_no_newline("\r" + prompt)
                } else if b3 == 70 {
                    // End
                    cursor = buf.length()
                    print_no_newline("\r" + prompt + buf)
                } else if b3 == 51 {
                    // Delete key (ESC[3~)
                    let b4: int = read_byte()
                    if cursor < buf.length() {
                        buf = buf.substring(0, cursor) + buf.substring(cursor + 1, buf.length())
                        redraw_line(prompt, buf, cursor)
                    }
                }
            }
        } else if b >= 32 and b < 127 {
            // Printable char
            if cursor == buf.length() {
                buf = buf + chr(b)
                cursor = cursor + 1
                print_no_newline(chr(b))
            } else {
                buf = buf.substring(0, cursor) + chr(b) + buf.substring(cursor, buf.length())
                cursor = cursor + 1
                redraw_line(prompt, buf, cursor)
            }
        }
    }

    raw_mode_exit()
    return buf
}

// ===== MAIN =====

fn main() -> int {
    let interactive: bool = isatty(0) == 1

    load_history()

    // Process command-line args
    let args: Array = get_args()
    if args.length() > 1 {
        let first: String = args[1]
        if first == "-c" and args.length() > 2 {
            let cmd: String = args[2]
            execute_line(cmd)
            return g_last_exit
        }
    }

    while g_running {
        var line: String = ""
        if interactive {
            line = read_line_interactive()
        } else {
            line = read_line()
            if line == ":EOF:" {
                g_running = false
                break
            }
        }

        let trimmed: String = line.trim()
        if trimmed.length() == 0 {
            continue
        }

        // Skip comment lines
        if char_at(trimmed, 0) == 35 {
            continue
        }

        add_history(trimmed)
        execute_line(trimmed)
    }

    save_history()
    return g_last_exit
}
